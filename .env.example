NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/tickets"

# Front-end URL, used to build links in emails
APP_URL="http://localhost:5173"
# Allowed origins, comma separated
CORS_ORIGIN="http://localhost:5173"

# At least 32 characters, generate a random value
JWT_ACCESS_SECRET=""
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# Leave empty in development to print emails in the console
BREVO_API_KEY=""
MAIL_FROM_EMAIL=""
MAIL_FROM_NAME="Support Ticket"

SUPER_ADMIN_EMAIL=""

# API documentation on /docs. Enabled by default except in production
# DOCS_ENABLED=true

# AI that answers the tickets: leave AI_API_KEY empty to disable it
# openai or deepseek (same API, only the address changes)
AI_PROVIDER="openai"
AI_API_KEY=""
# Prompt saved in the OpenAI dashboard (pmpt_...): its model and reference instructions are used
AI_PROMPT_ID=""
# Empty: the version published in the dashboard. A number pins one version
AI_PROMPT_VERSION=""
# Required without AI_PROMPT_ID (and with DeepSeek): check the model list of the provider
AI_MODEL=""
AI_TIMEOUT_MS=30000
# Automatic answers in a row before a person of the support team must take over
AI_MAX_AUTO_REPLIES=3
