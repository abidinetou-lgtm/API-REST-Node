NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/tickets"

# Front-end URL, used to build links in emails
APP_URL="http://localhost:5173"
# Allowed origins, comma separated
CORS_ORIGIN="http://localhost:5173"

# At least 32 characters, generate a random value
JWT_ACCESS_SECRET=""
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# Leave empty in development to print emails in the console
BREVO_API_KEY=""
MAIL_FROM_EMAIL=""
MAIL_FROM_NAME="Support Ticket"

SUPER_ADMIN_EMAIL=""
