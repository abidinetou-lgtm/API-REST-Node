Enum Role {
  SUPER_ADMIN
  ADMIN
  AGENT
  USER
}

Enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

Enum TokenType {
  INVITATION
  PASSWORD_RESET
}

Table User {
  id integer [pk, increment]
  email text [not null, unique]
  name text [not null]
  role Role [not null, default: 'USER']
  passwordHash text [note: 'Empty until the invitation is accepted']
  isActive boolean [not null, default: true]
  createdAt timestamp [not null, default: `now()`]
  updatedAt timestamp [not null]
}

Table Ticket {
  id integer [pk, increment]
  title text [not null]
  description text [not null]
  status TicketStatus [not null, default: 'OPEN']
  createdById integer [not null, ref: > User.id]
  createdAt timestamp [not null, default: `now()`]
  updatedAt timestamp [not null]

  indexes {
    createdById
  }
}

Table RefreshToken {
  id integer [pk, increment]
  tokenHash text [not null, unique]
  userId integer [not null, ref: > User.id]
  expiresAt timestamp [not null]
  revokedAt timestamp
  createdAt timestamp [not null, default: `now()`]

  indexes {
    userId
  }
}

Table UserToken {
  id integer [pk, increment]
  tokenHash text [not null, unique]
  type TokenType [not null]
  userId integer [not null, ref: > User.id]
  expiresAt timestamp [not null]
  usedAt timestamp
  createdAt timestamp [not null, default: `now()`]

  indexes {
    userId
  }
}
