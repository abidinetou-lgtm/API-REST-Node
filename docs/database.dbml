Enum Role {
  SUPER_ADMIN
  ADMIN
  AGENT
  USER
}

Enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

Enum TokenType {
  INVITATION
  PASSWORD_RESET
}

Enum AuditAction {
  USER_CREATED
  USER_ROLE_CHANGED
  USER_DISABLED
  USER_ENABLED
  INVITATION_RESENT
  INVITATION_ACCEPTED
  PASSWORD_RESET
  REFRESH_TOKEN_REUSED
  TICKET_STATUS_CHANGED
}

Enum AuditTargetType {
  USER
  TICKET
}

Table User {
  id uuid [pk, note: 'UUID v7']
  email text [not null, unique]
  name text [not null]
  role Role [not null, default: 'USER']
  passwordHash text [note: 'Empty until the invitation is accepted']
  isActive boolean [not null, default: true]
  createdAt timestamp [not null, default: `now()`]
  updatedAt timestamp [not null]
}

Table Ticket {
  id uuid [pk, note: 'UUID v7']
  title text [not null]
  description text [not null]
  status TicketStatus [not null, default: 'OPEN']
  createdById uuid [not null, ref: > User.id]
  createdAt timestamp [not null, default: `now()`]
  updatedAt timestamp [not null]

  indexes {
    createdById
  }
}

Table RefreshToken {
  id integer [pk, increment]
  tokenHash text [not null, unique]
  userId uuid [not null, ref: > User.id]
  expiresAt timestamp [not null]
  revokedAt timestamp
  createdAt timestamp [not null, default: `now()`]

  indexes {
    userId
  }
}

Table UserToken {
  id integer [pk, increment]
  tokenHash text [not null, unique]
  type TokenType [not null]
  userId uuid [not null, ref: > User.id]
  expiresAt timestamp [not null]
  usedAt timestamp
  createdAt timestamp [not null, default: `now()`]

  indexes {
    userId
  }
}

// Append only: rows are never updated or deleted
Table AuditLog {
  id uuid [pk, note: 'UUID v7']
  action AuditAction [not null]
  actorId uuid [ref: > User.id, note: 'Empty when the action is not done by a logged in user']
  targetType AuditTargetType [not null]
  targetId uuid [not null]
  metadata jsonb
  ipAddress text
  requestId text
  createdAt timestamp [not null, default: `now()`]

  indexes {
    actorId
    (targetType, targetId)
    action
    createdAt
  }
}
