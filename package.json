{
  "name": "api-rest-node",
  "version": "1.0.0",
  "description": "Support ticket REST API with authentication and role-based access control",
  "main": "dist/server.js",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "db:deploy": "prisma migrate deploy",
    "seed": "node dist/scripts/seed.js",
    "seed:dev": "tsx src/scripts/seed.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abidinetou-lgtm/API-REST-Node.git"
  },
  "keywords": [],
  "author": "Jimel Abidine Toure",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/abidinetou-lgtm/API-REST-Node/issues"
  },
  "homepage": "https://github.com/abidinetou-lgtm/API-REST-Node#readme",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
