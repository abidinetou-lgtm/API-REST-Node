generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum Role {
  SUPER_ADMIN
  ADMIN
  AGENT
  USER
}

enum TokenType {
  INVITATION
  PASSWORD_RESET
}

enum AuditAction {
  USER_CREATED
  USER_ROLE_CHANGED
  USER_DISABLED
  USER_ENABLED
  INVITATION_RESENT
  INVITATION_ACCEPTED
  PASSWORD_RESET
  REFRESH_TOKEN_REUSED
  TICKET_STATUS_CHANGED
  AI_SETTING_CHANGED
}

enum AuditTargetType {
  USER
  TICKET
  AI_SETTING
}

// Who wrote a message: the customer who opened the ticket, a person of the support team, or the AI
enum MessageAuthorType {
  CUSTOMER
  SUPPORT
  AI
}

model Ticket {
  id          String          @id @default(uuid(7)) @db.Uuid
  title       String
  description String
  status      TicketStatus    @default(OPEN)
  createdById String          @db.Uuid
  createdBy   User            @relation(fields: [createdById], references: [id])
  // true while the customer waits for an answer from a person of the support team
  needsAgent  Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  messages    TicketMessage[]

  @@index([createdById])
  @@index([status])
  @@index([needsAgent])
  @@index([createdAt])
}

model User {
  id            String            @id @default(uuid(7)) @db.Uuid
  email         String            @unique
  name          String
  role          Role              @default(USER)
  passwordHash  String?
  isActive      Boolean           @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  tickets       Ticket[]
  refreshTokens RefreshToken[]
  tokens        UserToken[]
  auditLogs     AuditLog[]
  messages      TicketMessage[]
  aiSettings    AiStatusSetting[]
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model UserToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique
  type      TokenType
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Append only: rows are never updated or deleted
model AuditLog {
  id         String          @id @default(uuid(7)) @db.Uuid
  action     AuditAction
  // Empty when the action is not done by a logged in user (seed, stolen token detection)
  actorId    String?         @db.Uuid
  actor      User?           @relation(fields: [actorId], references: [id], onDelete: Restrict)
  targetType AuditTargetType
  targetId   String          @db.Uuid
  metadata   Json?
  ipAddress  String?
  requestId  String?
  createdAt  DateTime        @default(now())

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([action])
  @@index([createdAt])
}

model TicketMessage {
  id         String            @id @default(uuid(7)) @db.Uuid
  ticketId   String            @db.Uuid
  ticket     Ticket            @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorType MessageAuthorType
  // Empty for the messages written by the AI
  authorId   String?           @db.Uuid
  author     User?             @relation(fields: [authorId], references: [id], onDelete: Restrict)
  body       String
  createdAt  DateTime          @default(now())

  @@index([ticketId, createdAt])
  @@index([authorId])
}

// How the AI behaves for one ticket status. Without a row, the default written in the code is used.
model AiStatusSetting {
  id           String       @id @default(uuid(7)) @db.Uuid
  status       TicketStatus @unique
  // Answers the customer by itself, or only writes drafts for the support team
  autoReply    Boolean
  instructions String
  updatedById  String?      @db.Uuid
  updatedBy    User?        @relation(fields: [updatedById], references: [id], onDelete: Restrict)
  updatedAt    DateTime     @updatedAt
}
